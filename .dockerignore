# Docker build context exclusions
# Context root: CORTEX/  (docker-compose.yml lives here)
# Only DE_Training/ scripts and Plugins/Schola-2.0.1/Resources/python/ are needed.

# ── UE5 build artifacts (large, not needed in container) ──────────────────────
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/

# ── UE5 source & content (not needed for Python training) ─────────────────────
Source/
Content/
Config/

# ── Training outputs (large, bind-mounted as volumes instead) ─────────────────
DE_Training/training_results/
DE_Training/models/
DE_Training/__pycache__/
DE_Training/**/__pycache__/
DE_Training/**/*.pyc
DE_Training/**/*.pyo

# ── Plugins: include only Schola-2.0.1 Python package ────────────────────────
Plugins/*
!Plugins/Schola-2.0.1/
Plugins/Schola-2.0.1/*
!Plugins/Schola-2.0.1/Resources/
Plugins/Schola-2.0.1/Resources/*
!Plugins/Schola-2.0.1/Resources/python/

# ── Git and IDE ───────────────────────────────────────────────────────────────
.git/
.gitignore
.gitmodules
.vscode/
.vs/
*.sln
*.vcxproj
*.vcxproj.filters

# ── Documentation (not needed in runtime image) ───────────────────────────────
*.md
!DE_Training/training/README.md

# ── Windows / macOS system files ─────────────────────────────────────────────
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
nul

# ── AWS / secrets (never in image) ───────────────────────────────────────────
DE_Training/aws/
DE_Training/aws_setup.sh
DE_Training/*.bat
